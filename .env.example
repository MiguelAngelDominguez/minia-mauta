# Puerto: Render inyecta PORT; local usa 8080.
PORT=8080
SERVER_PORT=8080

# Base de datos (Render: crear PostgreSQL gestionado y copiar credenciales).
DB_URL=jdbc:postgresql://localhost:5433/minia
DB_USER=minia
DB_PASSWORD=minia

# Dispositivo
DEVICE_TOKEN=dev-token

# IA / TTS: Gemini (unico modo soportado). Requiere GEMINI_API_KEYS.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# Consola web (origen permitido). Vacio si no hay frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Caché TTS en disco (relativo al working dir por defecto).
# minia.cache.dir=data/audio-cache